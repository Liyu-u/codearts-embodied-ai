# Huawei Cloud closed-loop service

# Bind address for the cloud web service.
CLOUD_BIND_HOST=127.0.0.1
CLOUD_BIND_PORT=8876

# SQLite database for cloud state, jobs, events, and artifacts.
CLOUD_DB_PATH=.cloud-runtime/cloud.sqlite3

# Public livestream URL exposed through the cloud UI.
CLOUD_HLS_URL=/live/isaac/index.m3u8

# Bearer token required by the relay when uploading evidence.
CLOUD_RELAY_TOKEN=change-me-before-production

# Required adapter modes for the real closed loop.
CLOUD_A_MODE=required
CLOUD_B_MODE=required
CLOUD_D_MODE=required

# Relay uploads only the allowlisted evidence artifacts.
CLOUD_ALLOWED_ARTIFACTS=perception.json,execution.json,final_pose.json,progress.jsonl,container_log_summary.json
