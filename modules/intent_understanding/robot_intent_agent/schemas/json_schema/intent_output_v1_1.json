{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent_output.v1.1",
  "title": "Intent Output v1.1",
  "description": "Flat downstream intent projection. Values are grounded in the sanitized perception observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "intent_id", "observation_id", "scene_id", "action",
    "target_object", "destination", "target_objects", "reference_object",
    "attributes", "resolved_attributes", "sort_criterion", "constraints",
    "plan_status", "execution_allowed", "confidence", "clarification",
    "errors", "unsupported_capabilities"
  ],
  "properties": {
    "schema_version": {"const": "intent_output.v1.1"},
    "intent_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": ["string", "null"]},
    "scene_id": {"type": ["string", "null"]},
    "action": {"type": "string", "minLength": 1},
    "target_object": {"type": ["string", "null"]},
    "destination": {"type": ["string", "null"]},
    "target_objects": {"type": "array", "items": {"type": "string"}},
    "reference_object": {"type": ["string", "null"]},
    "attributes": {"type": "object"},
    "resolved_attributes": {"type": "object"},
    "sort_criterion": {"type": ["string", "null"]},
    "constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/constraint"}
    },
    "plan_status": {"enum": ["READY", "NEEDS_CLARIFICATION", "BLOCKED"]},
    "execution_allowed": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "clarification": {"type": ["string", "null"]},
    "errors": {"type": "array", "items": {"type": "object"}},
    "unsupported_capabilities": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_type", "operator", "target_entity", "subject_entity", "source_event", "target_event", "min_value", "max_value", "value", "unit", "hard"],
      "properties": {
        "constraint_type": {"type": "string", "minLength": 1},
        "operator": {"type": ["string", "null"]},
        "target_entity": {"type": ["string", "null"]},
        "subject_entity": {"type": ["string", "null"]},
        "source_event": {"type": ["string", "null"]},
        "target_event": {"type": ["string", "null"]},
        "min_value": {"type": ["number", "null"]},
        "max_value": {"type": ["number", "null"]},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "hard": {"type": "boolean"}
      }
    }
  }
}
