{
  "$defs": {
    "BTNode": {
      "description": "行为树节点 — 递归结构。\n\nSequence 示例:\n    BTNode(\n        type=BTNodeType.SEQUENCE,\n        name=\"PickAndPlace\",\n        children=[\n            BTNode(type=BTNodeType.ACTION, name=\"Reach\",\n                   skill=SkillAction(skill_name=\"Reach\", target=\"red_bottle\")),\n            BTNode(type=BTNodeType.ACTION, name=\"Grasp\",\n                   skill=SkillAction(skill_name=\"GentleGrasp\", target=\"red_bottle\",\n                                     params={\"force\": 3.0})),\n            BTNode(type=BTNodeType.ACTION, name=\"MoveTo\",\n                   skill=SkillAction(skill_name=\"MoveTo\", target=\"user\")),\n            BTNode(type=BTNodeType.ACTION, name=\"Release\",\n                   skill=SkillAction(skill_name=\"Release\")),\n        ]\n    )",
      "properties": {
        "type": {
          "$ref": "#/$defs/BTNodeType",
          "description": "节点类型"
        },
        "name": {
          "description": "节点名称 (可读描述)",
          "title": "Name",
          "type": "string"
        },
        "children": {
          "description": "子节点列表 (Sequence/Fallback/Parallel 使用)",
          "items": {
            "$ref": "#/$defs/BTNode"
          },
          "title": "Children",
          "type": "array"
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "技能动作 (仅 Action 节点)"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "条件检查 (仅 Condition 节点)"
        },
        "decorator_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecoratorType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "修饰器类型 (仅 Decorator 节点)"
        },
        "decorator_params": {
          "additionalProperties": true,
          "description": "修饰器参数 ({max_retries: 3, timeout_s: 5.0})",
          "title": "Decorator Params",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/BTStatus",
          "default": "idle",
          "description": "执行状态"
        },
        "annotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "人工可读注释 (解释为什么这样规划)",
          "title": "Annotation"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "BTNode",
      "type": "object"
    },
    "BTNodeType": {
      "description": "行为树节点类型",
      "enum": [
        "sequence",
        "fallback",
        "parallel",
        "action",
        "condition",
        "decorator"
      ],
      "title": "BTNodeType",
      "type": "string"
    },
    "BTStatus": {
      "description": "节点执行状态",
      "enum": [
        "success",
        "failure",
        "running",
        "idle"
      ],
      "title": "BTStatus",
      "type": "string"
    },
    "ConditionCheck": {
      "description": "条件检查 — Condition 节点负载",
      "properties": {
        "condition": {
          "description": "条件表达式 (is_gripper_empty, object_in_view...)",
          "title": "Condition",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "检查目标",
          "title": "Target"
        },
        "expected": {
          "default": true,
          "description": "期望值",
          "title": "Expected"
        }
      },
      "required": [
        "condition"
      ],
      "title": "ConditionCheck",
      "type": "object"
    },
    "DecoratorType": {
      "description": "修饰器类型",
      "enum": [
        "retry",
        "timeout",
        "force_success",
        "force_failure",
        "invert",
        "repeat"
      ],
      "title": "DecoratorType",
      "type": "string"
    },
    "SkillAction": {
      "description": "原子技能 — Action 节点负载",
      "properties": {
        "skill_name": {
          "description": "技能名称 (Reach, Grasp, MoveTo, Release...)",
          "title": "Skill Name",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "目标物体 ID/名称",
          "title": "Target"
        },
        "params": {
          "additionalProperties": true,
          "description": "技能参数 ({force: 3.0, velocity: 0.1, ...})",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "skill_name"
      ],
      "title": "SkillAction",
      "type": "object"
    }
  },
  "description": "完整行为树 — Task Planner 输出。\n\n包含:\n    - 根节点 (BTNode 递归树)\n    - 元数据 (任务 ID、规划时间...)",
  "properties": {
    "tree_id": {
      "title": "Tree Id",
      "type": "string"
    },
    "task_id": {
      "description": "关联的任务 ID",
      "title": "Task Id",
      "type": "string"
    },
    "description": {
      "default": "",
      "description": "任务自然语言描述",
      "title": "Description",
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/BTNode",
      "description": "行为树根节点"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "规划元数据",
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "task_id",
    "root"
  ],
  "title": "BehaviorTree",
  "type": "object"
}