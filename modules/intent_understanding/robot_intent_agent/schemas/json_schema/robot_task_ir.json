{
  "$defs": {
    "Affordance": {
      "description": "物体可供性 (Gibsonian affordance)",
      "enum": [
        "graspable",
        "pushable",
        "pourable",
        "stackable",
        "openable",
        "container",
        "fragile",
        "movable",
        "fixed"
      ],
      "title": "Affordance",
      "type": "string"
    },
    "BTNode": {
      "description": "行为树节点 — 递归结构。\n\nSequence 示例:\n    BTNode(\n        type=BTNodeType.SEQUENCE,\n        name=\"PickAndPlace\",\n        children=[\n            BTNode(type=BTNodeType.ACTION, name=\"Reach\",\n                   skill=SkillAction(skill_name=\"Reach\", target=\"red_bottle\")),\n            BTNode(type=BTNodeType.ACTION, name=\"Grasp\",\n                   skill=SkillAction(skill_name=\"GentleGrasp\", target=\"red_bottle\",\n                                     params={\"force\": 3.0})),\n            BTNode(type=BTNodeType.ACTION, name=\"MoveTo\",\n                   skill=SkillAction(skill_name=\"MoveTo\", target=\"user\")),\n            BTNode(type=BTNodeType.ACTION, name=\"Release\",\n                   skill=SkillAction(skill_name=\"Release\")),\n        ]\n    )",
      "properties": {
        "type": {
          "$ref": "#/$defs/BTNodeType",
          "description": "节点类型"
        },
        "name": {
          "description": "节点名称 (可读描述)",
          "title": "Name",
          "type": "string"
        },
        "children": {
          "description": "子节点列表 (Sequence/Fallback/Parallel 使用)",
          "items": {
            "$ref": "#/$defs/BTNode"
          },
          "title": "Children",
          "type": "array"
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "技能动作 (仅 Action 节点)"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "条件检查 (仅 Condition 节点)"
        },
        "decorator_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecoratorType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "修饰器类型 (仅 Decorator 节点)"
        },
        "decorator_params": {
          "additionalProperties": true,
          "description": "修饰器参数 ({max_retries: 3, timeout_s: 5.0})",
          "title": "Decorator Params",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/BTStatus",
          "default": "idle",
          "description": "执行状态"
        },
        "annotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "人工可读注释 (解释为什么这样规划)",
          "title": "Annotation"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "BTNode",
      "type": "object"
    },
    "BTNodeType": {
      "description": "行为树节点类型",
      "enum": [
        "sequence",
        "fallback",
        "parallel",
        "action",
        "condition",
        "decorator"
      ],
      "title": "BTNodeType",
      "type": "string"
    },
    "BTStatus": {
      "description": "节点执行状态",
      "enum": [
        "success",
        "failure",
        "running",
        "idle"
      ],
      "title": "BTStatus",
      "type": "string"
    },
    "BehaviorTree": {
      "description": "完整行为树 — Task Planner 输出。\n\n包含:\n    - 根节点 (BTNode 递归树)\n    - 元数据 (任务 ID、规划时间...)",
      "properties": {
        "tree_id": {
          "title": "Tree Id",
          "type": "string"
        },
        "task_id": {
          "description": "关联的任务 ID",
          "title": "Task Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "任务自然语言描述",
          "title": "Description",
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/BTNode",
          "description": "行为树根节点"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "规划元数据",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "task_id",
        "root"
      ],
      "title": "BehaviorTree",
      "type": "object"
    },
    "BoundingBox": {
      "description": "3D 包围盒 (单位: m)",
      "properties": {
        "width": {
          "description": "宽度 (m)",
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "description": "高度 (m)",
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "depth": {
          "description": "深度 (m)",
          "exclusiveMinimum": 0,
          "title": "Depth",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "depth"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CollisionConstraint": {
      "description": "碰撞约束 — 与指定物体保持安全距离。\n\n示例:\n    \"别碰玻璃杯\" → CollisionConstraint(\n        avoid_object=\"glass_cup\",\n        min_distance_m=0.05,\n    )",
      "properties": {
        "constraint_type": {
          "$ref": "#/$defs/ConstraintType",
          "default": "collision"
        },
        "priority": {
          "$ref": "#/$defs/ConstraintPriority",
          "default": "hard"
        },
        "avoid_object": {
          "description": "避免碰撞的物体 ID/名称",
          "title": "Avoid Object",
          "type": "string"
        },
        "min_distance_m": {
          "default": 0.05,
          "description": "最小安全距离 (m)",
          "exclusiveMinimum": 0.0,
          "title": "Min Distance M",
          "type": "number"
        },
        "description": {
          "default": "",
          "description": "人类可读约束说明",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "avoid_object"
      ],
      "title": "CollisionConstraint",
      "type": "object"
    },
    "ConditionCheck": {
      "description": "条件检查 — Condition 节点负载",
      "properties": {
        "condition": {
          "description": "条件表达式 (is_gripper_empty, object_in_view...)",
          "title": "Condition",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "检查目标",
          "title": "Target"
        },
        "expected": {
          "default": true,
          "description": "期望值",
          "title": "Expected"
        }
      },
      "required": [
        "condition"
      ],
      "title": "ConditionCheck",
      "type": "object"
    },
    "ConstraintPriority": {
      "description": "约束优先级",
      "enum": [
        "hard",
        "soft"
      ],
      "title": "ConstraintPriority",
      "type": "string"
    },
    "ConstraintSet": {
      "description": "约束集合 — Hybrid Constraint Compiler 输出。\n\n将 Hard 和 Soft 约束分组管理。",
      "properties": {
        "set_id": {
          "title": "Set Id",
          "type": "string"
        },
        "task_id": {
          "description": "关联的任务 ID",
          "title": "Task Id",
          "type": "string"
        },
        "hard_constraints": {
          "description": "硬约束 (必须满足)",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ForceConstraint"
              },
              {
                "$ref": "#/$defs/VelocityConstraint"
              },
              {
                "$ref": "#/$defs/CollisionConstraint"
              },
              {
                "$ref": "#/$defs/HeightConstraint"
              },
              {
                "$ref": "#/$defs/TemporalConstraint"
              },
              {
                "$ref": "#/$defs/PreferenceConstraint"
              }
            ]
          },
          "title": "Hard Constraints",
          "type": "array"
        },
        "soft_constraints": {
          "description": "软约束 (尽量满足)",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ForceConstraint"
              },
              {
                "$ref": "#/$defs/VelocityConstraint"
              },
              {
                "$ref": "#/$defs/CollisionConstraint"
              },
              {
                "$ref": "#/$defs/HeightConstraint"
              },
              {
                "$ref": "#/$defs/TemporalConstraint"
              },
              {
                "$ref": "#/$defs/PreferenceConstraint"
              }
            ]
          },
          "title": "Soft Constraints",
          "type": "array"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "ConstraintSet",
      "type": "object"
    },
    "ConstraintType": {
      "description": "约束类型",
      "enum": [
        "force",
        "velocity",
        "collision",
        "height",
        "temporal",
        "preference"
      ],
      "title": "ConstraintType",
      "type": "string"
    },
    "DecoratorType": {
      "description": "修饰器类型",
      "enum": [
        "retry",
        "timeout",
        "force_success",
        "force_failure",
        "invert",
        "repeat"
      ],
      "title": "DecoratorType",
      "type": "string"
    },
    "ForceConstraint": {
      "description": "力约束。\n\n示例:\n    \"轻一点\" → ForceConstraint(max_force_n=3.0, axis=\"z\")\n    \"用力抓住\" → ForceConstraint(min_force_n=5.0, max_force_n=8.0)",
      "properties": {
        "constraint_type": {
          "$ref": "#/$defs/ConstraintType",
          "default": "force"
        },
        "priority": {
          "$ref": "#/$defs/ConstraintPriority",
          "default": "hard"
        },
        "min_force_n": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "最小力 (N)",
          "title": "Min Force N"
        },
        "max_force_n": {
          "default": 10.0,
          "description": "最大力 (N)",
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Max Force N",
          "type": "number"
        },
        "axis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "约束轴向 (x|y|z|grip)",
          "title": "Axis"
        },
        "description": {
          "default": "",
          "description": "人类可读约束说明",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "ForceConstraint",
      "type": "object"
    },
    "GripperState": {
      "description": "夹爪状态",
      "properties": {
        "is_open": {
          "default": true,
          "description": "是否张开",
          "title": "Is Open",
          "type": "boolean"
        },
        "width": {
          "default": 0.08,
          "description": "夹爪开度 (m)",
          "maximum": 0.1,
          "minimum": 0.0,
          "title": "Width",
          "type": "number"
        },
        "force": {
          "default": 0.0,
          "description": "当前夹持力 (N)",
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Force",
          "type": "number"
        },
        "has_object": {
          "default": false,
          "description": "是否持有物体",
          "title": "Has Object",
          "type": "boolean"
        }
      },
      "title": "GripperState",
      "type": "object"
    },
    "HeightConstraint": {
      "description": "高度约束 — Z 轴安全。\n\n示例:\n    assert z >= 0.02  → HeightConstraint(min_z_m=0.02)",
      "properties": {
        "constraint_type": {
          "$ref": "#/$defs/ConstraintType",
          "default": "height"
        },
        "priority": {
          "$ref": "#/$defs/ConstraintPriority",
          "default": "hard"
        },
        "min_z_m": {
          "default": 0.02,
          "description": "Z 轴最低安全高度 (m)",
          "exclusiveMinimum": 0.0,
          "title": "Min Z M",
          "type": "number"
        },
        "description": {
          "default": "",
          "description": "人类可读约束说明",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "HeightConstraint",
      "type": "object"
    },
    "JointState": {
      "description": "关节状态",
      "properties": {
        "angles": {
          "description": "7 自由度关节角 (rad)",
          "items": {
            "type": "number"
          },
          "title": "Angles",
          "type": "array"
        },
        "velocities": {
          "description": "关节速度 (rad/s)",
          "items": {
            "type": "number"
          },
          "title": "Velocities",
          "type": "array"
        }
      },
      "required": [
        "angles"
      ],
      "title": "JointState",
      "type": "object"
    },
    "OptimizationSpace": {
      "description": "下游优化器可调节的参数空间。\n\nCodeArts / TraceCoder 可以在这些边界内微调。",
      "properties": {
        "force_range_n": {
          "default": [
            1.0,
            10.0
          ],
          "description": "力范围 (min, max) N",
          "items": {},
          "title": "Force Range N",
          "type": "array"
        },
        "velocity_range_ms": {
          "default": [
            0.05,
            0.3
          ],
          "description": "速度范围 (min, max) m/s",
          "items": {},
          "title": "Velocity Range Ms",
          "type": "array"
        },
        "z_safe_margin_m": {
          "default": [
            0.02,
            0.1
          ],
          "description": "Z 安全边距范围 (m)",
          "items": {},
          "title": "Z Safe Margin M",
          "type": "array"
        },
        "collision_margin_m": {
          "default": [
            0.03,
            0.15
          ],
          "description": "碰撞边距范围 (m)",
          "items": {},
          "title": "Collision Margin M",
          "type": "array"
        },
        "targets": {
          "description": "优化目标优先级",
          "items": {
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        },
        "free_params": {
          "additionalProperties": true,
          "description": "扩展可调参数",
          "title": "Free Params",
          "type": "object"
        }
      },
      "title": "OptimizationSpace",
      "type": "object"
    },
    "Orientation": {
      "description": "3D 朝向 (Euler angles, 单位: rad)",
      "properties": {
        "roll": {
          "default": 0.0,
          "description": "Roll (rad)",
          "title": "Roll",
          "type": "number"
        },
        "pitch": {
          "default": 0.0,
          "description": "Pitch (rad)",
          "title": "Pitch",
          "type": "number"
        },
        "yaw": {
          "default": 0.0,
          "description": "Yaw (rad)",
          "title": "Yaw",
          "type": "number"
        }
      },
      "title": "Orientation",
      "type": "object"
    },
    "Position": {
      "description": "3D 位置 (世界坐标系, 单位: m)",
      "properties": {
        "x": {
          "description": "X 坐标 (m)",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Y 坐标 (m)",
          "title": "Y",
          "type": "number"
        },
        "z": {
          "description": "Z 坐标 (m)",
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Position",
      "type": "object"
    },
    "PreconditionAssertion": {
      "description": "单个前置条件",
      "properties": {
        "assertion": {
          "description": "断言表达式",
          "title": "Assertion",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "人类可读说明",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "assertion"
      ],
      "title": "PreconditionAssertion",
      "type": "object"
    },
    "PreconditionSet": {
      "description": "前置条件集合。\n\n在执行行为树之前必须全部满足。",
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/PreconditionAssertion"
          },
          "title": "Assertions",
          "type": "array"
        }
      },
      "title": "PreconditionSet",
      "type": "object"
    },
    "PreferenceConstraint": {
      "description": "用户偏好约束 (SOFT)。\n\n示例:\n    \"用左手递给我\" → PreferenceConstraint(\n        key=\"hand\", value=\"left\",\n    )",
      "properties": {
        "constraint_type": {
          "$ref": "#/$defs/ConstraintType",
          "default": "preference"
        },
        "priority": {
          "$ref": "#/$defs/ConstraintPriority",
          "default": "soft"
        },
        "key": {
          "description": "偏好键 (hand, speed_label, grip_style...)",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "description": "偏好值",
          "title": "Value"
        },
        "description": {
          "default": "",
          "description": "人类可读约束说明",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "PreferenceConstraint",
      "type": "object"
    },
    "RobotState": {
      "description": "机器人完整状态快照",
      "properties": {
        "gripper": {
          "$ref": "#/$defs/GripperState"
        },
        "joint_state": {
          "$ref": "#/$defs/JointState"
        },
        "battery": {
          "default": 100.0,
          "description": "电量 (%)",
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Battery",
          "type": "number"
        },
        "is_homed": {
          "default": true,
          "description": "是否已归位",
          "title": "Is Homed",
          "type": "boolean"
        }
      },
      "title": "RobotState",
      "type": "object"
    },
    "SceneObject": {
      "description": "场景中的单个物体。\n\n示例:\n    SceneObject(\n        id=\"obj-001\",\n        name=\"红色药瓶\",\n        position=Position(x=0.15, y=0.05, z=0.03),\n        bbox=BoundingBox(width=0.03, height=0.08, depth=0.03),\n        attributes={\"color\": \"red\", \"material\": \"plastic\"},\n        affordances=[Affordance.GRASPABLE, Affordance.FRAGILE],\n    )",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "物体名称",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "语义标签 (bottle, cup, cube...)",
          "title": "Label"
        },
        "position": {
          "$ref": "#/$defs/Position",
          "description": "3D 世界坐标"
        },
        "orientation": {
          "$ref": "#/$defs/Orientation"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox",
          "description": "包围盒尺寸"
        },
        "attributes": {
          "additionalProperties": true,
          "description": "自由属性 (color, material, weight...)",
          "title": "Attributes",
          "type": "object"
        },
        "affordances": {
          "description": "可供性列表",
          "items": {
            "$ref": "#/$defs/Affordance"
          },
          "title": "Affordances",
          "type": "array"
        }
      },
      "required": [
        "name",
        "position",
        "bbox"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "SemanticSceneGraph": {
      "description": "完整语义场景图。\n\n包含:\n    - 所有场景物体 (含属性、可供性)\n    - 物体间空间关系\n    - 机器人当前状态",
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 时间戳",
          "title": "Timestamp"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/SpatialRelation"
          },
          "title": "Relations",
          "type": "array"
        },
        "robot_state": {
          "$ref": "#/$defs/RobotState"
        }
      },
      "title": "SemanticSceneGraph",
      "type": "object"
    },
    "SkillAction": {
      "description": "原子技能 — Action 节点负载",
      "properties": {
        "skill_name": {
          "description": "技能名称 (Reach, Grasp, MoveTo, Release...)",
          "title": "Skill Name",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "目标物体 ID/名称",
          "title": "Target"
        },
        "params": {
          "additionalProperties": true,
          "description": "技能参数 ({force: 3.0, velocity: 0.1, ...})",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "skill_name"
      ],
      "title": "SkillAction",
      "type": "object"
    },
    "SpatialPredicate": {
      "description": "空间关系谓词",
      "enum": [
        "left_of",
        "right_of",
        "above",
        "below",
        "in_front_of",
        "behind",
        "inside",
        "next_to",
        "near",
        "blocking",
        "supporting"
      ],
      "title": "SpatialPredicate",
      "type": "string"
    },
    "SpatialRelation": {
      "description": "两个物体之间的空间关系",
      "properties": {
        "subject": {
          "description": "主体物体 ID",
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "$ref": "#/$defs/SpatialPredicate",
          "description": "空间谓词"
        },
        "object": {
          "description": "客体物体 ID",
          "title": "Object",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "description": "关系置信度",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "额外信息 (距离、遮挡程度...)",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "title": "SpatialRelation",
      "type": "object"
    },
    "TaskMetadata": {
      "description": "任务元数据",
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "raw_instruction": {
          "description": "用户原始自然语言指令",
          "title": "Raw Instruction",
          "type": "string"
        },
        "language": {
          "default": "zh",
          "description": "语言 (zh|en)",
          "title": "Language",
          "type": "string"
        },
        "created_at": {
          "description": "创建时间 (ISO 8601)",
          "title": "Created At",
          "type": "string"
        },
        "user_context": {
          "additionalProperties": true,
          "description": "用户上下文 (偏好、历史...)",
          "title": "User Context",
          "type": "object"
        }
      },
      "required": [
        "raw_instruction"
      ],
      "title": "TaskMetadata",
      "type": "object"
    },
    "TemporalConstraint": {
      "description": "时序约束。\n\n示例:\n    \"先打开夹爪再抓取\" → TemporalConstraint(before=\"open_gripper\", after=\"close_gripper\")",
      "properties": {
        "constraint_type": {
          "$ref": "#/$defs/ConstraintType",
          "default": "temporal"
        },
        "priority": {
          "$ref": "#/$defs/ConstraintPriority",
          "default": "hard"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "在此技能之前执行",
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "在此技能之后执行",
          "title": "After"
        },
        "description": {
          "default": "",
          "description": "人类可读约束说明",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "TemporalConstraint",
      "type": "object"
    },
    "VelocityConstraint": {
      "description": "速度约束。\n\n示例:\n    \"慢一点\" → VelocityConstraint(max_linear_ms=0.15)\n    \"动作快些\" → VelocityConstraint(max_linear_ms=0.5)",
      "properties": {
        "constraint_type": {
          "$ref": "#/$defs/ConstraintType",
          "default": "velocity"
        },
        "priority": {
          "$ref": "#/$defs/ConstraintPriority",
          "default": "hard"
        },
        "max_linear_ms": {
          "default": 0.3,
          "description": "最大线速度 (m/s)",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Max Linear Ms",
          "type": "number"
        },
        "max_angular_rads": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "最大角速度 (rad/s)",
          "title": "Max Angular Rads"
        },
        "description": {
          "default": "",
          "description": "人类可读约束说明",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "VelocityConstraint",
      "type": "object"
    }
  },
  "description": "机器人任务中间表示 (Intermediate Representation)。\n\n这是整个意图理解管道的最终输出 Schema。\n\n架构:\n    ir_version              → 版本号 (CodeArts 兼容性)\n    task_metadata           → 任务元数据\n    precondition_assertions → 前置条件 (执行前必须全部满足)\n    scene                   → 语义场景图\n    behavior_tree           → 可执行行为树\n    skills                  → 技能映射表\n    compiled_constraints    → 编译后的约束集\n    optimization_space      → 下游优化边界",
  "properties": {
    "ir_version": {
      "default": "1.0.0",
      "description": "IR 版本号 (兼容性标识)",
      "title": "Ir Version",
      "type": "string"
    },
    "task_metadata": {
      "$ref": "#/$defs/TaskMetadata"
    },
    "precondition_assertions": {
      "$ref": "#/$defs/PreconditionSet",
      "description": "前置条件断言"
    },
    "scene": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticSceneGraph"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "语义场景图"
    },
    "behavior_tree": {
      "$ref": "#/$defs/BehaviorTree",
      "description": "行为树"
    },
    "skills": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "技能映射表 (skill_name → {params, constraints, ...})",
      "title": "Skills",
      "type": "object"
    },
    "compiled_constraints": {
      "$ref": "#/$defs/ConstraintSet",
      "description": "编译后约束集"
    },
    "optimization_space": {
      "$ref": "#/$defs/OptimizationSpace",
      "description": "可调优参数空间"
    },
    "memory_context": {
      "additionalProperties": true,
      "description": "Memory 模块注入的上下文",
      "title": "Memory Context",
      "type": "object"
    }
  },
  "required": [
    "task_metadata",
    "behavior_tree"
  ],
  "title": "RobotTaskIR",
  "type": "object"
}