# Optional: required only for DeepSeek and Hybrid evaluations.
RIA_DEEPSEEK_API_KEY=sk-

RIA_DEEPSEEK_BASE_URL=https://api.deepseek.com
RIA_DEEPSEEK_MODEL=deepseek-v4-pro
# Compact semantic parsing uses a fast non-thinking model by default.
RIA_DEEPSEEK_SEMANTIC_MODEL=deepseek-v4-flash
RIA_DEEPSEEK_SEMANTIC_MAX_TOKENS=1400
RIA_DEEPSEEK_SEMANTIC_TIMEOUT_S=45
RIA_DEEPSEEK_SEMANTIC_MAX_RETRIES=1
RIA_DEEPSEEK_SEMANTIC_DISABLE_THINKING=true

# rule | llm | hybrid
# hybrid: every request invokes the LLM when a key is configured, then falls
# back to the rule planner on model/API/schema failures.
RIA_PLANNER_ENGINE=hybrid

# daily | industrial
RIA_DEPLOYMENT_DOMAIN=daily
RIA_DAILY_MAX_FORCE_N=10
RIA_DAILY_MAX_VELOCITY_MS=0.30
RIA_INDUSTRIAL_MAX_FORCE_N=8
RIA_INDUSTRIAL_MAX_VELOCITY_MS=0.15

# B strategy generation through Huawei Cloud CodeArts Agent CLI.
# auto: use CodeArts when installed, otherwise safe local fallback
# required: block strategy generation when CodeArts fails
# off: deterministic local primitive strategy only
CODEARTS_STRATEGY_MODE=auto
CODEARTS_CLI=codearts
# Optional CodeArts custom agent/model. Empty values use CLI defaults.
CODEARTS_STRATEGY_AGENT=
CODEARTS_STRATEGY_MODEL=
CODEARTS_STRATEGY_TIMEOUT_S=120
