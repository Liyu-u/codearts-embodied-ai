# A 意图理解模块（RIA）本地配置模板
#
# 使用 tools/setup.ps1 自动生成 .env。不要把真实 API Key 提交到 Git。
# 该文件只放 RIA_ 前缀的字段；B、D 的配置分别放在 codearts.env 和
# tracecoder_llm.env，避免 pydantic-settings 的 extra=forbid 配置冲突。

RIA_DEEPSEEK_API_KEY=
RIA_DEEPSEEK_BASE_URL=https://api.deepseek.com
RIA_DEEPSEEK_MODEL=deepseek-v4-flash
RIA_DEEPSEEK_TEMPERATURE=0.0
RIA_DEEPSEEK_MAX_TOKENS=2400
RIA_DEEPSEEK_TIMEOUT_S=15
RIA_DEEPSEEK_MAX_RETRIES=1
RIA_DEEPSEEK_THINKING=disabled
RIA_DEEPSEEK_REASONING_EFFORT=low
RIA_LLM_CACHE_ENABLED=true
RIA_LLM_CACHE_MAX_ENTRIES=128

# rule：纯规则；llm：强制 LLM；hybrid：规则/LLM 混合
RIA_PLANNER_ENGINE=llm
RIA_LLM_FALLBACK_ON_LOW_CONFIDENCE=false
RIA_LLM_FAILURE_POLICY=block
RIA_RULE_CONFIDENCE_THRESHOLD=0.6

# local / sim / real 执行安全档位
RIA_DEPLOYMENT_DOMAIN=daily
RIA_DAILY_MAX_FORCE_N=10
RIA_DAILY_MAX_VELOCITY_MS=0.30
RIA_INDUSTRIAL_MAX_FORCE_N=8
RIA_INDUSTRIAL_MAX_VELOCITY_MS=0.15
