# D TraceCoder LLM 本地配置模板
#
# 使用 tools/setup.ps1 自动生成仓库根目录的 tracecoder_llm.env。
# 不要把真实 API Key 提交到 Git。

# adaptive：按成功/失败风险分级；legacy：恢复旧版固定预算并调用成功路径（应急回滚）
TRACECODER_ADAPTIVE_ROUTING=adaptive

# off：纯规则；optional：LLM 失败时回退规则；required：LLM 失败即阻断
TRACECODER_LLM_MODE=required
TRACECODER_LLM_MODEL=deepseek-v4-flash
TRACECODER_LLM_BASE_URL=https://api.deepseek.com
TRACECODER_LLM_API_KEY=
TRACECODER_LLM_TIMEOUT_S=20
TRACECODER_LLM_MAX_RETRIES=1
TRACECODER_LLM_TEMPERATURE=0.0
TRACECODER_LLM_MAX_TOKENS=3072
TRACECODER_LLM_JSON_MODE=true
TRACECODER_LLM_THINKING=disabled
TRACECODER_LLM_REASONING_EFFORT=low
TRACECODER_MAX_REPAIR_ATTEMPTS=1
# 困难故障：仅在连续失败、复杂修复或显式升级时使用
TRACECODER_LLM_HARD_MAX_TOKENS=6144
TRACECODER_LLM_HARD_THINKING=enabled
TRACECODER_LLM_HARD_REASONING_EFFORT=low
TRACECODER_LLM_HARD_MAX_RETRIES=1
TRACECODER_HARD_MAX_REPAIR_ATTEMPTS=1

# 极少数疑难样本：显式 tracecoder_profile=expert 时保留高预算
TRACECODER_LLM_EXPERT_MAX_TOKENS=8192
TRACECODER_LLM_EXPERT_MAX_RETRIES=1
TRACECODER_EXPERT_MAX_REPAIR_ATTEMPTS=2
TRACECODER_EXPERT_OPTIMIZE_QUALITY=true

# 旧版兼容档位参数，仅在 TRACECODER_ADAPTIVE_ROUTING=legacy 时生效
TRACECODER_LEGACY_MAX_TOKENS=8192
TRACECODER_LEGACY_THINKING=enabled
TRACECODER_LEGACY_REASONING_EFFORT=low
TRACECODER_LEGACY_MAX_RETRIES=2
TRACECODER_LEGACY_MAX_REPAIR_ATTEMPTS=2
TRACECODER_LEGACY_OPTIMIZE_QUALITY=true
