# D TraceCoder LLM 本地配置模板
#
# 使用 tools/setup.ps1 自动生成仓库根目录的 tracecoder_llm.env。
# 不要把真实 API Key 提交到 Git。

# off：纯规则；optional：LLM 失败时回退规则；required：LLM 失败即阻断
TRACECODER_LLM_MODE=required
TRACECODER_LLM_MODEL=deepseek-v4-flash
TRACECODER_LLM_BASE_URL=https://api.deepseek.com
TRACECODER_LLM_API_KEY=
TRACECODER_LLM_TIMEOUT_S=20
TRACECODER_LLM_MAX_RETRIES=1
TRACECODER_LLM_TEMPERATURE=0.0
TRACECODER_LLM_MAX_TOKENS=4096
TRACECODER_LLM_JSON_MODE=true
TRACECODER_LLM_THINKING=enabled
TRACECODER_LLM_REASONING_EFFORT=low
TRACECODER_MAX_REPAIR_ATTEMPTS=2
