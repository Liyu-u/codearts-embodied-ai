{
  "schema_version": "closed-loop-benchmark.v1",
  "name": "abcd_closed_loop_v1",
  "version": "1.0.0",
  "description": "自研 A/B/C/D 全链路联调基准。以公开具身智能基准的语言落地、多任务组合、长链动作、场景变化和失败恢复思想为设计依据，但以本项目 v1 协议、Isaac/Mock 执行边界和 TraceCoder 安全策略为最终判定标准。",
  "default_repeats": 3,
  "design_basis": [
    {
      "benchmark": "ALFRED",
      "method": "自然语言目标、指代消解、长链家庭任务",
      "applied_to": ["grounded_language", "intent_safety"]
    },
    {
      "benchmark": "TEACh",
      "method": "对话式澄清、目标缺失和交互式任务完成",
      "applied_to": ["intent_safety", "capability_boundary"]
    },
    {
      "benchmark": "LIBERO/CALVIN",
      "method": "多任务组合、语言条件动作链、实体/空间关系迁移",
      "applied_to": ["happy_path", "capability_boundary"]
    },
    {
      "benchmark": "BEHAVIOR-1K/RoboCasa365",
      "method": "场景多样性、目标组合和长时程闭环",
      "applied_to": ["happy_path", "execution_failure"]
    },
    {
      "benchmark": "REBOOT/failure-aware recovery",
      "method": "把执行失败、恢复和不可恢复状态作为一等测试信号",
      "applied_to": ["recoverable_failure", "safe_stop", "execution_failure"]
    }
  ],
  "protocol_contracts": [
    "perception.v1",
    "task.v1",
    "strategy.v1",
    "execution.v1",
    "feedback.v1"
  ],
  "evaluation_gates": {
    "contract_pass_rate": 1.0,
    "intent_safety_block_precision": 1.0,
    "safe_stop_correct_rate": 1.0,
    "code_null_rate": 1.0,
    "target_task_success_rate": 0.95,
    "required_repeat_stability": 1.0,
    "d_repair_cases_must_not_bypass_policy": true
  },
  "case_schema": {
    "required": [
      "id",
      "category",
      "source",
      "expected_status",
      "seed",
      "benchmark_basis",
      "test_dimensions"
    ],
    "replay_fields": [
      "scene_id",
      "instruction",
      "path",
      "failures",
      "expected_retry_count",
      "requires_d_repair"
    ]
  },
