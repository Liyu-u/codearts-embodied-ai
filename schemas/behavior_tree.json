{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Behavior Tree — 行为树定义",
  "description": "任务规划器输出的可执行行为树结构",
  "version": "0.1.0",
  "type": "object",
  "required": ["tree_id", "root"],
  "properties": {
    "tree_id": { "type": "string" },
    "task_id": { "type": "string" },
    "root": { "$ref": "#/definitions/BTNode" }
  },
  "definitions": {
    "BTNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type":"string","enum":["sequence","fallback","parallel","action","condition","decorator"]},
        "name": {"type":"string"},
        "children": {"type":"array","items":{"$ref":"#/definitions/BTNode"}},
        "params": {"type":"object"}
      }
    }
  }
}
