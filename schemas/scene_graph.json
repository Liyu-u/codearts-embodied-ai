{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene Graph — 场景图表示",
  "description": "环境感知模块输出的结构化场景描述",
  "version": "0.1.0",
  "type": "object",
  "required": ["scene_id", "objects", "spatial_relations"],
  "properties": {
    "scene_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "objects": { "type": "array", "items": { "$ref": "#/definitions/SceneObject" } },
    "spatial_relations": { "type": "array", "items": { "$ref": "#/definitions/SpatialRelation" } }
  },
  "definitions": {
    "SceneObject": {
      "type": "object",
      "required": ["name", "position", "bbox"],
      "properties": {
        "name": {"type":"string"},
        "position": {"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"},"z":{"type":"number"}}},
        "bbox": {"type":"object","properties":{"width":{"type":"number"},"height":{"type":"number"},"depth":{"type":"number"}}},
        "color": {"type":"string"},
        "label": {"type":"string"},
        "attributes": {"type":"object"}
      }
    },
    "SpatialRelation": {
      "type": "object",
      "required": ["subject", "relation", "object"],
      "properties": {
        "subject": {"type":"string"},
        "relation": {"type":"string","enum":["on_top","next_to","behind","in_front_of","inside","above","below"]},
        "object": {"type":"string"}
      }
    }
  }
}
