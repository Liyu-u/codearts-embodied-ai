# ===========================================
# 华为揭榜挂帅 — 环境变量配置模版
# ===========================================
# 复制此文件为 .env 并填入真实值
# ⚠️ .env 已加入 .gitignore，切勿提交真实密钥！

# --- 华为云 CodeArts ---
CODEARTS_API_KEY=your_codearts_api_key_here
CODEARTS_ENDPOINT=https://codearts-api.huaweicloud.com/v1

# --- LLM API (OpenAI 兼容格式) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- Isaac Sim ---
ISAAC_SIM_PATH=/path/to/isaac_sim
ISAAC_SCENE_PATH=./src/isaac/scenes/default.usd

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG_MODE=true

# --- Logs ---
LOG_DIR=./logs
LOG_LEVEL=INFO
