# ===========================================
# 环境变量模版 — 华为揭榜挂帅项目
# ===========================================
# 复制此文件为 .env 并填入真实值
# 注意：.env 已加入 .gitignore，切勿提交真实密钥！

# --- 华为云 CodeArts ---
CODEARTS_API_KEY=your_codearts_api_key_here
CODEARTS_ENDPOINT=https://codearts-api.huaweicloud.com/v1

# --- LLM API (兼容 OpenAI 格式) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- 数据库 ---
DATABASE_URL=sqlite:///./data/app.db

# --- Isaac Sim ---
ISAAC_SIM_PATH=/path/to/isaac_sim
ISAAC_SCENE_PATH=./src/isaac/scenes/default.usd

# --- 服务器 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG_MODE=true

# --- 日志级别 ---
LOG_LEVEL=INFO
