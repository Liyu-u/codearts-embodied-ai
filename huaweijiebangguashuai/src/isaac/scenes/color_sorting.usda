#usda 1.0
(
    doc = """场景3: 颜色分类
    用途: 测试 sort_by_color + push 动作
    内容: 红/蓝/绿方块各2个, 混放在桌面上
    队友 A: "按颜色分类, 红色放左边, 蓝色放中间, 绿色放右边"
    队友 B: sort_by_color(robot, "blue", drop_zone)
    分类区: red(0.1,-0.2) blue(0.3,-0.2) green(0.5,-0.2)
    """
)

def Xform "World"
{
    # 桌面
    def Cube "Table"
    {
        double3 xformOp:translate = (0.3, 0.0, 0.0)
        double3 xformOp:scale = (0.8, 1.0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.5, 0.35, 0.2)]
    }

    # 红色方块 A
    def Cube "RedCube_A" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.10, 0.05, 0.03)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(1.0, 0.0, 0.0)]
        token semantic:label = "cube"
        string semantic:color = "red"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }

    # 蓝色方块 A
    def Cube "BlueCube_A" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.25, -0.10, 0.03)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.0, 0.0, 1.0)]
        token semantic:label = "cube"
        string semantic:color = "blue"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }

    # 绿色方块 A
    def Cube "GreenCube_A" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.40, 0.08, 0.03)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.0, 1.0, 0.0)]
        token semantic:label = "cube"
        string semantic:color = "green"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }

    # 红色方块 B
    def Cube "RedCube_B" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.15, -0.15, 0.03)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(1.0, 0.0, 0.0)]
        token semantic:label = "cube"
        string semantic:color = "red"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }

    # 蓝色方块 B
    def Cube "BlueCube_B" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.50, -0.05, 0.03)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.0, 0.0, 1.0)]
        token semantic:label = "cube"
        string semantic:color = "blue"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }

    # 绿色方块 B
    def Cube "GreenCube_B" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.35, 0.15, 0.03)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.0, 1.0, 0.0)]
        token semantic:label = "cube"
        string semantic:color = "green"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }
}
