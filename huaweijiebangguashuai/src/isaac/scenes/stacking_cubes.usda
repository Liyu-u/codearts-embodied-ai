#usda 1.0
(
    doc = """场景1: 方块堆叠
    用途: 测试 pick_and_place + stack 动作
    内容: 红色方块在底层, 蓝色方块在中间, 绿色方块在顶层
    队友 A: "把绿色方块从顶上拿下来放到右边"
    队友 B: pick_and_place(robot, green_block, 0.4, 0.0)
    """
)

def Xform "World"
{
    # 桌面
    def Cube "Table"
    {
        double3 xformOp:translate = (0.3, 0.0, 0.0)
        double3 xformOp:scale = (0.8, 1.0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.5, 0.35, 0.2)]
    }

    # 底层: 红色方块
    def Cube "RedCube_Bottom" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.25, 0.0, 0.04)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(1.0, 0.0, 0.0)]
        token semantic:label = "cube"
        string semantic:color = "red"

        # PhysX 刚体属性
        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }

    # 中间: 蓝色方块
    def Cube "BlueCube_Middle" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.25, 0.0, 0.08)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.0, 0.0, 1.0)]
        token semantic:label = "cube"
        string semantic:color = "blue"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }

    # 顶层: 绿色方块
    def Cube "GreenCube_Top" (
        apiSchemas = ["PhysxRigidBodyAPI", "PhysxCollisionAPI"]
    )
    {
        double3 xformOp:translate = (0.25, 0.0, 0.12)
        double3 xformOp:scale = (0.04, 0.04, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.0, 1.0, 0.0)]
        token semantic:label = "cube"
        string semantic:color = "green"

        uniform bool physxRigidBody:rigidBodyEnabled = true
        uniform float physxRigidBody:mass = 0.15
        uniform token physxRigidBody:material = "plastic"
        uniform bool physxCollision:collisionEnabled = true
    }
}
