# B CodeArts CLI 本地配置模板
#
# 使用 tools/setup.ps1 自动生成仓库根目录的 codearts.env。
# CodeArts CLI 也会从当前用户环境读取 CODEARTS_CLI_AK/SK；
# 真实凭证禁止提交 Git。

CODEARTS_CLI=codearts
CODEARTS_STRATEGY_MODE=auto
CODEARTS_STRATEGY_AGENT=
CODEARTS_STRATEGY_MODEL=
CODEARTS_STRATEGY_TIMEOUT_S=120
CODEARTS_STRATEGY_POLICY=planner
CODEARTS_CLI_PURE=1

CODEARTS_CLI_AK=
CODEARTS_CLI_SK=
